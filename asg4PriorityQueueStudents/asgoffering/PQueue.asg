    // public int dequeue() throws NoSuchElementException
    group Dequeue {
        tests State {
            fiveNode: <5,4,3,2,1>.dequeue() -> <4,2,3,1>
            six: <12,9,10,6,7,8>.dequeue() -> <10,9,8,6,7>
            three: <10,5,8>.dequeue() -> <8,5>
        }
        tests Value {
            fiveNode: <5,4,3,2,1>.dequeue() == 5
            six: <12,9,10,6,7,8>.dequeue() == 12
            three: <10,5,8>.dequeue() == 10
           
        }
        tests Exception {
            /** */
            empty: <>.dequeue() !! NoSuchElementException
            
        }
    }

    /**
